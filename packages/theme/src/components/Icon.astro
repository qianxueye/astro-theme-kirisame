---
interface Props { name: string; class?: string }
const { name, class: className = '' } = Astro.props;
const paths: Record<string, string> = {
  arrow: 'M4 12h15m-5-5 5 5-5 5', back: 'M20 12H5m5-5-5 5 5 5',
  top: 'M12 20V5m-5 5 5-5 5 5', close: 'm6 6 12 12M6 18 18 6',
  menu: 'M4 7h16M4 12h16M4 17h16', down: 'm7 10 5 5 5-5',
  focus: 'M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5',
  moon: 'M20.7 13.3A8.8 8.8 0 0 1 10.7 3.2 8.8 8.8 0 1 0 20.7 13.3Z',
  sun: 'M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4',
  rss: 'M5 4a15 15 0 0 1 15 15M5 10a9 9 0 0 1 9 9', search: 'm16 16 4.2 4.2'
};
---
<svg class:list={['icon', className]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d={paths[name] || paths.arrow} />
  {name === 'search' && <circle cx="10.8" cy="10.8" r="6.7" />}
  {name === 'sun' && <circle cx="12" cy="12" r="4" />}
  {name === 'rss' && <circle cx="5" cy="19" r="1" />}
</svg>
