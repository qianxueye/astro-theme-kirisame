---
import type { ThemeConfig } from '../types';
import { withBase } from '../lib/content.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import ReaderControls from '../components/ReaderControls.astro';
import '../styles/base.css';
import '../styles/motion.css';
import '../styles/content.css';
interface Props { config: ThemeConfig; title?: string; description?: string; article?: boolean; noindex?: boolean; published?: Date; updated?: Date }
const { config, title, description = config.description, article = false, noindex = false, published, updated } = Astro.props;
const canonical = new URL(Astro.url.pathname, config.url);
const pageTitle = title ? `${title} · ${config.title}` : config.title;
---
<!doctype html>
<html lang={config.lang} data-appearance={config.appearance} data-motion-default={config.motion} data-font-default={config.reading.font} data-size-default={config.reading.size}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title><meta name="description" content={description} /><meta name="author" content={config.author} />
    <link rel="canonical" href={canonical} /><link rel="alternate" type="application/rss+xml" title={config.title} href={withBase(config.base, '/rss.xml')} />
    {(!config.indexable || noindex) && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:type" content={article ? 'article' : 'website'} /><meta property="og:site_name" content={config.title} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let p = {};
        try { p = JSON.parse(localStorage.getItem('kirisame-reading-v1') || '{}') || {}; } catch {}
        root.classList.add('has-js');
        const choice = ['light','dark','auto'].includes(p.theme) ? p.theme : root.dataset.appearance;
        root.dataset.theme = choice === 'auto' ? (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light') : choice;
        root.dataset.readerFont = ['sans','serif'].includes(p.font) ? p.font : root.dataset.fontDefault;
        root.style.setProperty('--reader-size', ([17,19,21].includes(p.size) ? p.size : Number(root.dataset.sizeDefault) || 19) + 'px');
        root.dataset.motion = (p.motion === 'off' || (!p.motion && root.dataset.motionDefault === 'off') || matchMedia('(prefers-reduced-motion:reduce)').matches) ? 'off' : 'on';
      })();
    </script>
    <slot name="head" />
  </head>
  <body class:list={[{ 'is-article': article }]} data-base={config.base} data-search-pagefind={!import.meta.env.DEV}>
    <a class="skip-link" href="#main-content">跳转到正文</a>
    <div class="reading-progress" aria-hidden="true"><span></span></div>
    <Header config={config} />
    <main id="main-content" class="site-main" tabindex="-1"><slot /></main>
    <Footer config={config} />
    {config.search && <SearchDialog />}
    <ReaderControls />
    <button class="exit-focus js-only" type="button">退出专注</button>
    <div id="toast" class="toast" role="status" aria-live="polite"></div>
    <script>import '../scripts/client.js';</script>
    <slot name="body-end" />
  </body>
</html>
